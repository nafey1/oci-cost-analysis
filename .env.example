# Server
PORT=3000

# OCI auth method: config, instance_principal, or resource_principal.
OCI_AUTH_METHOD=config

# Config-file auth. Uses your local OCI CLI config by default.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Optional for config-file auth because the tenancy is inferred from the OCI profile.
# Required for principal-based auth if the provider cannot expose a tenancy OCID.
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exampleuniqueid

# Defaults used by the dashboard/API if callers do not provide query params.
OCI_USAGE_REGION=us-ashburn-1
# Optional. Omit dates to use the last complete calendar month.
# DEFAULT_START_DATE=2026-04-01
# DEFAULT_END_DATE=2026-05-01
DEFAULT_GRANULARITY=DAILY
DEFAULT_QUERY_TYPE=COST
DEFAULT_GROUP_BY=service
CACHE_TTL_SECONDS=300

# File-backed report persistence. Stores previous scan JSON under this directory.
PERSIST_REPORTS=true
OCI_COST_DATA_DIR=./data
PERSIST_MAX_REPORTS=250
